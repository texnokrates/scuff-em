/* config.h -- generated by CMake for SCUFF-EM.  Do not edit. */
#ifndef SCUFF_CONFIG_H
#define SCUFF_CONFIG_H

/* Fortran name-mangling macros.
 *
 * FortranCInterface generates F77_GLOBAL/F77_GLOBAL_; the historical
 * SCUFF-EM sources use F77_FUNC/F77_FUNC_, so provide those names here. */
#include "F77.h"
#define F77_FUNC(name,NAME) F77_GLOBAL(name,NAME)
#define F77_FUNC_(name,NAME) F77_GLOBAL_(name,NAME)

/* Package identification */
#define PACKAGE "@PROJECT_NAME@"
#define PACKAGE_NAME "@PROJECT_NAME@"
#define PACKAGE_TARNAME "@PROJECT_NAME@"
#define PACKAGE_VERSION "@SCUFF_VERSION_STRING@"
#define PACKAGE_STRING "@PROJECT_NAME@ @SCUFF_VERSION_STRING@"
#define PACKAGE_BUGREPORT "homer@homerreid.com"
#define PACKAGE_URL ""
#define VERSION "@SCUFF_VERSION_STRING@"

/* Required numerical libraries */
#cmakedefine HAVE_BLAS 1
#cmakedefine HAVE_LAPACK 1

/* Language features */
#define HAVE_CXX11 1

/* Optional libraries */
#cmakedefine HAVE_HDF5 1
#cmakedefine HAVE_LIBGSL 1
#cmakedefine HAVE_LIBGSLCBLAS 1
#cmakedefine HAVE_LIBREADLINE 1
#cmakedefine HAVE_READLINE 1
#cmakedefine HAVE_DCUTRI 1
#cmakedefine HAVE_LIBGDSII 1

/* Threading */
#cmakedefine HAVE_OPENMP 1
#cmakedefine USE_OPENMP 1
#cmakedefine HAVE_PTHREAD 1
#cmakedefine USE_PTHREAD 1

/* Platform facilities */
#cmakedefine HAVE_EXECINFO_H 1
#cmakedefine HAVE_BACKTRACE 1
#cmakedefine HAVE_ISNAN 1
#cmakedefine HAVE_ISINF 1
#cmakedefine HAVE_ERF 1
#cmakedefine HAVE_ERFC 1
#cmakedefine HAVE_COPYSIGN 1

#endif /* SCUFF_CONFIG_H */
