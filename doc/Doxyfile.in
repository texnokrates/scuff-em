# Doxygen configuration for the SCUFF-EM documentation.
#
# Processed by CMake (cmake/ScuffDocs.cmake), which substitutes the
# @...@ placeholders.  The generated file lives in the build directory;
# run `doxygen doc/Doxyfile` from the build directory, or simply build
# the `docs` target.

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "scuff-em"
PROJECT_NUMBER         = @SCUFF_VERSION@
PROJECT_BRIEF          = "Boundary-element analysis of electromagnetic scattering, fluctuation-induced phenomena, and RF device modeling"
PROJECT_LOGO           = "@CMAKE_SOURCE_DIR@/doc/docs/reference/scuffEMLogo.png"

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------

# The public library headers provide the API reference; the markdown
# tree under doc/docs provides the narrative documentation (tutorials,
# reference pages, application manuals); doc/dox holds the glue pages
# that tie everything together.
INPUT                  = "@CMAKE_SOURCE_DIR@/libs" \
                         "@CMAKE_SOURCE_DIR@/doc/docs" \
                         "@CMAKE_SOURCE_DIR@/doc/docs/examples" \
                         "@CMAKE_SOURCE_DIR@/doc/dox"

RECURSIVE              = YES

# Implementation-only sources are not part of the public API reference.
EXCLUDE                = "@CMAKE_SOURCE_DIR@/libs/libSGJC" \
                         "@CMAKE_SOURCE_DIR@/libs/libTriInt" \
                         "@CMAKE_SOURCE_DIR@/libs/libMDInterp/cmatheval" \
                         "@CMAKE_SOURCE_DIR@/libs/libMDInterp/ReadMesh.cc" \
                         "@CMAKE_SOURCE_DIR@/libs/libMatProp/cmatheval"

EXCLUDE_PATTERNS       = */.git/* \
                         *Internals.h \
                         *Test*.cc

EXAMPLE_PATH           = "@CMAKE_SOURCE_DIR@/examples"

# mkdocs-syntax cleanup filter; see doc/doxygen/md-filter.py
INPUT_FILTER           = "python3 @CMAKE_SOURCE_DIR@/doc/doxygen/md-filter.py"
FILTER_SOURCE_FILES    = NO

FILE_PATTERNS          = *.h *.hh *.md *.dox *.c
EXTENSION_MAPPING      = dox=C++

# ---------------------------------------------------------------------------
# Extraction
# ---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = NO
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@CMAKE_SOURCE_DIR@/libs"
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 4
MARKDOWN_ID_STYLE      = DOXYGEN
TOC_INCLUDE_HEADINGS   = 5

# The codebase is in a transitional state: many doc comments are plain
# block comments rather than Doxygen comments.  Warnings about these
# are collected in a log file rather than spamming the build output.
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = "@CMAKE_BINARY_DIR@/doc/doxygen-warnings.log"

# ---------------------------------------------------------------------------
# Language
# ---------------------------------------------------------------------------

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
TYPEDEF_HIDES_STRUCT   = NO
HIDE_SCOPE_NAMES       = NO
HIDE_COMPOUND_REFERENCE= NO

# ---------------------------------------------------------------------------
# HTML output
# ---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = @CMAKE_BINARY_DIR@/doc/html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
DISABLE_INDEX          = NO

# Formulas in the markdown documentation use TeX notation; MathJax
# renders them client-side.
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_2
MATHJAX_FORMAT         = HTML-CSS
MATHJAX_RELPATH        = https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.9

# ---------------------------------------------------------------------------
# Source browsing
# ---------------------------------------------------------------------------

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
REFERENCES_LINK_SOURCE = NO
ALPHABETICAL_INDEX     = YES

# ---------------------------------------------------------------------------
# Other output formats
# ---------------------------------------------------------------------------

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_PERLMOD       = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES

# ---------------------------------------------------------------------------
# Diagrams
# ---------------------------------------------------------------------------

HAVE_DOT               = @SCUFF_HAVE_DOT@
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
HIDE_UNDOC_RELATIONS   = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DIRECTORY_GRAPH        = NO
GRAPHICAL_HIERARCHY    = YES
DOT_IMAGE_FORMAT       = png
DOT_MULTI_TARGETS      = NO
MAX_DOT_GRAPH_DEPTH    = 2
DOT_CLEANUP            = YES
